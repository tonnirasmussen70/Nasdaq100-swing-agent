//@version=6
strategy("Asian/London Breakout · Strategy Tester", overlay = true, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = true, use_bar_magnifier = true)

// TradingView execution wrapper around the Python signal rules.
// Use on standard 5-minute OHLC bars. Sessions are interpreted in Europe/London.
// Signal parity is checked with asian_breakout_signal_v6.pine; this strategy adds
// TradingView's broker-emulator execution model and therefore is not the parity oracle.

const string TZ = "Europe/London"
const string ASIAN_SESSION = "0000-0730:23456"
const string ENTRY_SESSION = "0800-1000:23456"

profile = input.string("Control", "Profile", options = ["Control", "Challenger", "Custom"])
customMaxAsianRange = input.float(2.50, "Custom max Asian range %", minval = 0.01, step = 0.05)
customMinBodyRatio = input.float(0.60, "Custom minimum body ratio", minval = 0.0, maxval = 1.0, step = 0.05)
customRewardRisk = input.float(2.00, "Custom reward/risk", minval = 0.1, step = 0.1)
showRange = input.bool(true, "Show Asian range")

float minAsianRangePct = 0.10
float maxAsianRangePct = profile == "Control" ? 2.50 : profile == "Challenger" ? 1.00 : customMaxAsianRange
float minBodyRatio = profile == "Control" ? 0.60 : profile == "Challenger" ? 0.60 : customMinBodyRatio
float rewardRisk = profile == "Control" ? 2.00 : profile == "Challenger" ? 2.50 : customRewardRisk
float longCloseLocationMin = 0.80
float shortCloseLocationMax = 0.20
float breakoutBufferPct = 0.02
float stopBufferPct = 0.02

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool inAsian = not na(time(timeframe.period, ASIAN_SESSION, TZ))
bool inEntryWindow = not na(time(timeframe.period, ENTRY_SESSION, TZ))
bool firstAsianBar = inAsian and (bar_index == 0 or not inAsian[1])

var float asianHigh = na
var float asianLow = na
var bool paritySignalSeenToday = false

if firstAsianBar
    asianHigh := high
    asianLow := low
    paritySignalSeenToday := false
else if inAsian
    asianHigh := na(asianHigh) ? high : math.max(asianHigh, high)
    asianLow := na(asianLow) ? low : math.min(asianLow, low)

float midpoint = not na(asianHigh) and not na(asianLow) ? (asianHigh + asianLow) / 2.0 : na
float asianRangePct = not na(midpoint) and midpoint > 0 ? (asianHigh - asianLow) / midpoint * 100.0 : na
float candleRange = high - low
float bodyRatio = candleRange > 0 ? math.abs(close - open) / candleRange : na
float closeLocation = candleRange > 0 ? (close - low) / candleRange : na
float longLevel = not na(asianHigh) ? asianHigh * (1.0 + breakoutBufferPct / 100.0) : na
float shortLevel = not na(asianLow) ? asianLow * (1.0 - breakoutBufferPct / 100.0) : na

bool rangeOk = not na(asianRangePct) and asianRangePct >= minAsianRangePct and asianRangePct <= maxAsianRangePct
bool bodyOk = not na(bodyRatio) and bodyRatio >= minBodyRatio
bool commonGate = isFiveMinute and barstate.isconfirmed and inEntryWindow and not inAsian and not paritySignalSeenToday and rangeOk and bodyOk

bool rawLongSignal = commonGate and open > asianHigh and close > longLevel and closeLocation >= longCloseLocationMin
bool rawShortSignal = commonGate and open < asianLow and close < shortLevel and closeLocation <= shortCloseLocationMax

float entryRef = rawLongSignal or rawShortSignal ? close : na
float stopRef = rawLongSignal ? low - stopBufferPct / 100.0 * close : rawShortSignal ? high + stopBufferPct / 100.0 * close : na
float riskPoints = rawLongSignal ? entryRef - stopRef : rawShortSignal ? stopRef - entryRef : na
float targetRef = rawLongSignal ? entryRef + rewardRisk * riskPoints : rawShortSignal ? entryRef - rewardRisk * riskPoints : na

bool flat = strategy.position_size == 0
bool tradeLong = rawLongSignal and flat
bool tradeShort = rawShortSignal and flat
bool skippedWhileOpen = (rawLongSignal or rawShortSignal) and not flat

if rawLongSignal or rawShortSignal
    paritySignalSeenToday := true

if tradeLong
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", stop = stopRef, limit = targetRef)

if tradeShort
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", stop = stopRef, limit = targetRef)

plot(showRange ? asianHigh : na, "Asian High", color = color.new(color.teal, 0), style = plot.style_stepline)
plot(showRange ? asianLow : na, "Asian Low", color = color.new(color.orange, 0), style = plot.style_stepline)
plotshape(rawLongSignal, title = "Parity LONG", style = shape.triangleup, location = location.belowbar, size = size.tiny)
plotshape(rawShortSignal, title = "Parity SHORT", style = shape.triangledown, location = location.abovebar, size = size.tiny)
plotshape(skippedWhileOpen, title = "Signal skipped because position is open", style = shape.xcross, location = location.abovebar, size = size.tiny)

alertcondition(rawLongSignal, "Asian breakout LONG", "Asian/London breakout LONG parity signal")
alertcondition(rawShortSignal, "Asian breakout SHORT", "Asian/London breakout SHORT parity signal")

if barstate.islast and not isFiveMinute
    label.new(bar_index, high, "Use a standard 5-minute chart", style = label.style_label_down)
